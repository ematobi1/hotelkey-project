# Hotel Key — Environment Variables
# Copy this file to .env and fill in all values before running dev-start.ps1

# ─── Shared / Infrastructure ─────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (shared cluster, one DB per service)
# Local:  postgresql://hotelkey:hotelkey123@localhost:5432/<db>
# RDS:    postgresql://hotelkey:HotelKey2026!@<rds-host>:5432/<db>?sslmode=no-verify

# Redis
REDIS_URL=redis://localhost:6379

# Kafka (KRaft mode, no ZooKeeper)
KAFKA_BROKERS=localhost:9094

# ─── Auth Service (port 3001) ─────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_auth

# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then: base64 -w0 private.pem && base64 -w0 public.pem
JWT_PRIVATE_KEY_BASE64=<base64-encoded-RSA-private-key>
JWT_PUBLIC_KEY_BASE64=<base64-encoded-RSA-public-key>

# JWT TTLs (optional — defaults shown)
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7

# 32-byte hex string (64 chars): openssl rand -hex 32
MFA_ENCRYPTION_KEY=<64-char-hex-string>

# ─── Guest Service (port 3002) ────────────────────────────────────────────────
GUEST_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_guest
VAULT_SERVICE_URL=http://localhost:3012

# ─── Reservation Service (port 3003) ─────────────────────────────────────────
RESERVATION_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_reservation
ROOM_SERVICE_URL=http://localhost:3004

# ─── Room Service (port 3004) ─────────────────────────────────────────────────
ROOM_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_room

# ─── Billing Service (port 3005) ──────────────────────────────────────────────
BILLING_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_billing
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>

# ─── Housekeeping Service (port 3006) ────────────────────────────────────────
HOUSEKEEPING_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_housekeeping
ML_SERVICE_URL=http://localhost:8001

# ─── Notification Service (port 3007) ────────────────────────────────────────
NOTIFICATION_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_notification
MONGODB_URL=mongodb://localhost:27017/hotel_key_notifications
SES_FROM_ADDRESS=noreply@yourdomain.com

# AWS credentials for SES (optional if using instance role / ECS task role)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Twilio (optional — SMS notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── PMS Service (port 3008) ──────────────────────────────────────────────────
PMS_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_pms

# ─── Maintenance Service (port 3009) ─────────────────────────────────────────
MAINTENANCE_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_maintenance
FAILURE_PREDICTION_THRESHOLD=0.35

# ─── Lock Service (port 3010) ─────────────────────────────────────────────────
LOCK_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_lock
ASSA_ABLOY_API_BASE_URL=https://api.assaabloy.com
ASSA_ABLOY_API_KEY=<assa-abloy-api-key>

# ─── Channel Manager Service (port 3011) ─────────────────────────────────────
CHANNEL_MANAGER_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_channel_manager
SITEMINDER_API_BASE_URL=https://api.siteminder.com
SITEMINDER_API_KEY=<siteminder-api-key>
SITEMINDER_WEBHOOK_SECRET=<siteminder-webhook-secret>

# ─── Vault Service (port 3012) ────────────────────────────────────────────────
VAULT_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=<hashicorp-vault-root-token>
# 32-byte hex string: openssl rand -hex 32
ENCRYPTION_KEY=<64-char-hex-string>

# ─── Consent Service (port 3013) ─────────────────────────────────────────────
CONSENT_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_consent
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_MSP_ID=HotelKeyMSP
FABRIC_CERT_PATH=/path/to/fabric/cert.pem
FABRIC_KEY_PATH=/path/to/fabric/key.pem
FABRIC_TLS_CERT_PATH=/path/to/fabric/tls-cert.pem

# ─── Webhook Service (port 3014) ─────────────────────────────────────────────
WEBHOOK_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_webhook

# ─── Integration Service (port 3015) ─────────────────────────────────────────
INTEGRATION_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_integration

# Third-party integrations (all optional)
# LIGHTSPEED_API_KEY=
# ORACLE_SIMPHONY_API_KEY=
# SQUARE_API_KEY=
# DORMAKABA_API_KEY=
# SALTO_API_KEY=
# CLOUDBEDS_API_KEY=
# RATEGAIN_API_KEY=
# GUESTLINE_API_KEY=

# ─── BI Service (port 3016) ───────────────────────────────────────────────────
BI_DATABASE_URL=postgresql://hotelkey:hotelkey123@localhost:5432/hotel_key_bi
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>
BILLING_SERVICE_URL=http://localhost:3005
RESERVATION_SERVICE_URL=http://localhost:3003

# ─── Observability (optional) ─────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
