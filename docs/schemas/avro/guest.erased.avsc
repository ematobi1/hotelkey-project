{
  "type": "record",
  "name": "GuestErased",
  "namespace": "io.hotelkey.events",
  "doc": "CloudEvents envelope for hotel-key.guest.erased (GDPR erasure)",
  "fields": [
    {"name": "specversion", "type": "string", "default": "1.0"},
    {"name": "id", "type": "string"},
    {"name": "source", "type": "string"},
    {"name": "type", "type": "string", "default": "hotel-key.guest.erased"},
    {"name": "time", "type": "string"},
    {"name": "datacontenttype", "type": "string", "default": "application/json"},
    {"name": "tenantid", "type": "string"},
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "GuestErasedData",
        "fields": [
          {"name": "guestId", "type": "string"},
          {"name": "tenantId", "type": "string"},
          {"name": "erasedAt", "type": "string"}
        ]
      }
    }
  ]
}
