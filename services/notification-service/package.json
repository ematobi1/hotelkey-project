{
  "name": "@hotel-key/notification-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "tsup src/server.ts --format cjs --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.47.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@aws-sdk/client-ses": "^3.574.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@hotel-key/config": "workspace:*",
    "@hotel-key/kafka": "workspace:*",
    "@hotel-key/logger": "workspace:*",
    "@hotel-key/types": "workspace:*",
    "fastify": "^4.27.0",
    "handlebars": "^4.7.8",
    "jose": "^5.3.0",
    "mongodb": "^6.6.0",
    "pg": "^8.11.5",
    "twilio": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.5",
    "tsup": "^8.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
