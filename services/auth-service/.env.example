NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://hotel_key:hotel_key_dev@localhost:5432/hotel_key_auth

# Generate with: openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
JWT_PRIVATE_KEY_BASE64=

# Generate with: openssl ec -in <(openssl ecparam -genkey -name prime256v1 -noout) -pubout | base64 -w0
JWT_PUBLIC_KEY_BASE64=

JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7

# 32-byte hex: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
